#!/usr/bin/env Rscript
###############################################################################
# HPC Species Distribution Modelling – ALL SPECIES
# BG models: presence + background
# PA models: presence + pseudoabsence
# Includes evaluation and variable importance extraction
###############################################################################

cat("Using sdm version:", paste(packageVersion("sdm")), "\n")

library(terra)
library(sdm)
library(flexsdm)
library(dplyr)

installAll()

###############################################################################
# 1. PATHS
###############################################################################

occ_file <- "/projects/F202415137CPCAA0/small_pel_geofiltering/modelling_all_spp/occurrence_dfs/all_spp_nativerangefiltered_ap.csv"
tif_path <- "/projects/F202415137CPCAA0/small_pel_geofiltering/present.tif"

out_path <- "/projects/F202415137CPCAA0/small_pel_geofiltering/modelling_all_spp/results_serious_run"
out_ca   <- "/projects/F202415137CPCAA0/small_pel_geofiltering/modelling_all_spp/buffer_area_serious_run"
out_bg   <- "/projects/F202415137CPCAA0/small_pel_geofiltering/modelling_all_spp/background_serious_run"
out_psa  <- "/projects/F202415137CPCAA0/small_pel_geofiltering/modelling_all_spp/pseudoabsence_serious_run"
out_eval <- file.path(out_path, "evaluation")

dir.create(out_path, showWarnings=FALSE, recursive=TRUE)
dir.create(out_ca, showWarnings=FALSE, recursive=TRUE)
dir.create(out_bg, showWarnings=FALSE, recursive=TRUE)
dir.create(out_psa, showWarnings=FALSE, recursive=TRUE)
dir.create(out_eval, showWarnings=FALSE, recursive=TRUE)

###############################################################################
# 2. LOAD DATA
###############################################################################

cat("Loading occurrence data...\n")

df <- read.csv(occ_file)

cat("Total records:", nrow(df), "\n")

cat("Loading predictor raster...\n")

predictors <- terra::rast(tif_path)

cat("Predictor raster has", terra::nlyr(predictors), "layers\n")

###############################################################################
# 3. SPECIES LIST
###############################################################################

species_list <- unique(df$species)

cat("Found", length(species_list), "species\n")

###############################################################################
# 4. FUNCTIONS
###############################################################################

extract_eval <- function(model, species_name, model_type){

  info <- getModelInfo(model)

  ids <- info$modelID

  ev_list <- lapply(ids, function(i){
    tryCatch(
      getEvaluation(model, id=i, stat=c("AUC","TSS")),
      error=function(e) NULL
    )
  })

  ev_list <- ev_list[!sapply(ev_list,is.null)]

  if(length(ev_list)==0) return(NULL)

  ev <- do.call(rbind, ev_list)

  ev_full <- merge(ev,
                   info[,c("modelID","method")],
                   by="modelID")

  summary_table <- ev_full %>%
    group_by(method) %>%
    summarise(
      mean_AUC = mean(AUC, na.rm=TRUE),
      mean_TSS = mean(TSS, na.rm=TRUE),
      .groups="drop"
    )

  summary_table$species <- species_name
  summary_table$model_type <- model_type

  return(summary_table)
}


extract_varimp <- function(model, species_name, model_type){

  info <- getModelInfo(model)

  ids <- info$modelID

  vi_list <- lapply(ids, function(i){
    tryCatch(
      getVarImp(model, id=i),
      error=function(e) NULL
    )
  })

  vi_list <- vi_list[!sapply(vi_list,is.null)]

  if(length(vi_list)==0) return(NULL)

vi <- do.call(rbind, lapply(vi_list, as.data.frame))

  vi$species <- species_name
  vi$model_type <- model_type

  return(vi)
}

###############################################################################
# 5. SPECIES LOOP
###############################################################################

for(sp_name in species_list){

cat("\n=================================================\n")
cat("Processing species:", sp_name,"\n")
cat("=================================================\n")

try({

###############################################################################
# OCCURRENCES
###############################################################################

spp <- df %>% filter(species==sp_name)

cat("Occurrences:", nrow(spp),"\n")

if(nrow(spp)<20){
cat("Skipped — too few records\n")
next
}

###############################################################################
# CALIBRATION AREA
###############################################################################

ca <- flexsdm::calib_area(
data=spp,
x="lon",
y="lat",
method=c("buffer", width=1000000),
crs="EPSG:4326"
)

ca <- terra::project(ca, terra::crs(predictors))

terra::writeVector(
ca,
file.path(out_ca,paste0(sp_name,"_calibration_area.gpkg")),
overwrite=TRUE
)

###############################################################################
# BACKGROUND
###############################################################################

set.seed(10)

bg <- flexsdm::sample_background(
data=spp,
x="lon",
y="lat",
n=10000,
method="random",
rlayer=predictors,
calibarea=ca
) %>%
rename(x=lon,y=lat) %>%
mutate(pa=0)

write.csv(
bg,
file.path(out_bg,paste0(sp_name,"_background.csv")),
row.names=FALSE
)

###############################################################################
# PSEUDOABSENCE
###############################################################################

set.seed(10)

psa <- flexsdm::sample_pseudoabs(
data=spp,
x="lon",
y="lat",
n=2*nrow(spp),
method="random",
rlayer=predictors,
calibarea=ca
) %>%
dplyr::rename(x=lon,y=lat) %>%
dplyr::mutate(pa=0)

write.csv(
psa,
file.path(out_psa,paste0(sp_name,"_pseudoabsence.csv")),
row.names=FALSE
)

###############################################################################
# PRESENCE DATA
###############################################################################

pres <- spp %>%
dplyr::rename(x=lon,y=lat) %>%
dplyr::mutate(pa=1) %>%
dplyr::select(pa,x,y)

###############################################################################
# DATASETS
###############################################################################

model_bg <- dplyr::bind_rows(pres, bg %>% dplyr::select(pa,x,y))
model_psa <- dplyr::bind_rows(pres, psa %>% dplyr::select(pa,x,y))

###############################################################################
# SDM DATA
###############################################################################

sdm_bg <- sdmData(pa~.+coords(x+y),train=model_bg,predictors=predictors)

sdm_psa <- sdmData(pa~.+coords(x+y),train=model_psa,predictors=predictors)

###############################################################################
# BACKGROUND MODELS
###############################################################################

cat("Running BG models...\n")

m_bg <- sdm(
pa~.+coords(x+y),
data=sdm_bg,
methods=c(
"maxent",
"maxlike",
"bioclim",
"bioclim.dismo",
"domain.dismo",
"mahal.dismo"
),
replication="sub",
test.p=30,
n=50,
parallelSetting=list(ncore=7,method="parallel",fork=FALSE)
)

###############################################################################
# PSEUDOABSENCE MODELS
###############################################################################

cat("Running PA models...\n")

m_psa <- sdm(
pa~.+coords(x+y),
data=sdm_psa,
methods=c(
"brt","gam","glm","mlp","rf","rpart","svm",
"cart","fda","glmnet","mars","mda","rbf"
),
replication="sub",
test.p=30,
n=50,
parallelSetting=list(ncore=7,method="parallel",fork=FALSE)
)

###############################################################################
# EVALUATION
###############################################################################

cat("Evaluating models...\n")

eval_bg  <- extract_eval(m_bg,sp_name,"background")
eval_psa <- extract_eval(m_psa,sp_name,"pseudoabsence")

eval_all <- bind_rows(eval_bg,eval_psa)

if(!is.null(eval_all)){

write.csv(
eval_all,
file=file.path(out_eval,paste0(sp_name,"_evaluation.csv")),
row.names=FALSE
)

}

###############################################################################
# SAVE MODELS
###############################################################################

saveRDS(
m_bg,
file=file.path(out_path,paste0(sp_name,"_sdm_BG_models.rds"))
)

saveRDS(
m_psa,
file=file.path(out_path,paste0(sp_name,"_sdm_PSA_models.rds"))
)

cat("Completed:",sp_name,"\n")

}, silent=FALSE)

}
